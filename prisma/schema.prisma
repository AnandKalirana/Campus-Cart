// Campus Cart data model.
// Ownership rules: every user-owned row carries the owner's id; services must authorize
// against the SESSION user, never against ids supplied by the client.
// Money is stored as whole rupees (Int). Zod enforces 0 < price <= MAX and price <= originalPrice.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum Condition {
  LIKE_NEW
  GOOD
  USED
}

enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD
  REMOVED // removed by owner (soft delete) or by an admin
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED // seller marked sold AND buyer confirmed
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model University {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  city         String?
  // Institutional email domains that may verify as this campus, e.g. ["tcetmumbai.in"]. Admin-managed.
  emailDomains String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users    User[]
  products Product[]
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique // stored lowercase; normalized in the service layer
  emailVerified  DateTime? // set only after the token flow completes; gates selling/messaging
  passwordHash   String? // null for OAuth-only accounts. Argon2id/bcrypt hash only, never plaintext.
  name           String
  image          String?
  role           Role          @default(STUDENT)
  status         AccountStatus @default(ACTIVE)
  // Bumped on password reset (and by admins) so already-issued JWT sessions stop working.
  sessionVersion Int           @default(0)
  universityId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  accounts         Account[]
  tokens           AuthToken[]
  products         Product[]
  wishlist         Wishlist[]
  buyerChats       Conversation[]    @relation("ChatBuyer")
  sellerChats      Conversation[]    @relation("ChatSeller")
  messages         Message[]
  purchaseRequests PurchaseRequest[]
  reportsFiled     Report[]          @relation("ReportReporter")
  reportsResolved  Report[]          @relation("ReportResolver")
  notifications    Notification[]

  @@index([universityId])
  @@index([role, status])
}

// OAuth provider links (Google). Credentials sign-in does not use this table.
model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Email verification and password reset. Only a SHA-256 hash of the token is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String  @unique
  blurb     String
  icon      String // Lucide icon name
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  products Product[]

  @@index([sortOrder])
}

model Product {
  id             String        @id @default(cuid())
  sellerId       String
  universityId   String
  categoryId     String
  title          String        @db.VarChar(120)
  description    String        @db.VarChar(2000)
  price          Int // whole rupees
  originalPrice  Int?
  condition      Condition
  status         ListingStatus @default(ACTIVE)
  pickupLocation String        @db.VarChar(160)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  seller     User       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images           ProductImage[]
  wishlist         Wishlist[]
  conversations    Conversation[]
  purchaseRequests PurchaseRequest[]
  reports          Report[]

  // Browse: campus + status + newest / category / price sorting.
  @@index([universityId, status, createdAt(sort: Desc)])
  @@index([categoryId, status, createdAt(sort: Desc)])
  @@index([status, price])
  @@index([sellerId, status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String // storage URL (Cloudinary / Supabase Storage)
  publicId  String // storage object id, used for cleanup on delete
  position  Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
}

model Wishlist {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

// One thread per (listing, buyer). The seller is denormalized so access checks need no join.
model Conversation {
  id        String   @id @default(cuid())
  productId String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // bumped on each message for list ordering

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation("ChatBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("ChatSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([productId, buyerId])
  @@index([buyerId, updatedAt(sort: Desc)])
  @@index([sellerId, updatedAt(sort: Desc)])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @db.VarChar(2000)
  readAt         DateTime? // set when the other participant reads it; drives unread indicators
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

// Purchase request, not a payment. No money moves through Campus Cart.
model PurchaseRequest {
  id                 String        @id @default(cuid())
  productId          String
  buyerId            String
  status             RequestStatus @default(PENDING)
  note               String?       @db.VarChar(500)
  sellerMarkedSoldAt DateTime?
  buyerConfirmedAt   DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  // A buyer has at most one request per listing (re-request by updating status).
  @@unique([productId, buyerId])
  @@index([productId, status])
  @@index([buyerId, status])
}

model Report {
  id           String       @id @default(cuid())
  productId    String
  reporterId   String
  reason       String       @db.VarChar(500)
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter   User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  // One report per user per listing stops report-spam.
  @@unique([productId, reporterId])
  @@index([status, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    @db.VarChar(40) // e.g. "purchase_request", "message"
  title     String    @db.VarChar(120)
  href      String?   @db.VarChar(200) // internal path only; validated before render
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}
