# Placeholders only. Copy to .env.local and fill in. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/campus_cart"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Public base URL, used in emailed links. Must be https in production.
APP_URL="http://localhost:3000"

# Neon (get values from the Neon console or `neon deploy`; keep real values in .env.local)
# DIRECT_URL is the non-pooled connection used by Prisma migrate. Optional for the app.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Auth.js: when self-hosting (not Vercel), tell it which host to trust, otherwise sign-in fails with "UntrustedHost".
# Set AUTH_URL to your public https URL (preferred) or AUTH_TRUST_HOST=true behind a trusted proxy.
# AUTH_URL="https://your-domain.example"
# AUTH_TRUST_HOST="true"

# Photo storage (Neon Object Storage, S3-compatible). `neon env pull` writes these into .env.local.
# Without them, development falls back to local disk (.data/uploads). Production REQUIRES them.
# AWS_ENDPOINT_URL_S3="https://<branch>.storage.<region>.aws.neon.tech"
# AWS_REGION="us-east-2"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# STORAGE_BUCKET="assets"
# STORAGE_DRIVER="local"   # force local disk (dev/CI only, never production)

# Email (verification + password reset). Production REQUIRES a real driver; "log" prints mails to the console and is dev/test only.
# MAIL_DRIVER="brevo"            # log | resend | brevo   (see docs/EMAIL_SETUP.md)
# MAIL_FROM="Campus Cart <no-reply@your-verified-domain>"
# RESEND_API_KEY=""               # server-side only, never NEXT_PUBLIC_
# BREVO_API_KEY=""

# Bot protection (Cloudflare Turnstile). Required in production: login and sign-up refuse without them.
# Cloudflare's official always-pass TEST keys for local work: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""   # public by design; baked in at build time
# TURNSTILE_SECRET_KEY=""             # server only

# Rate limiting
# RATE_LIMIT_STORE="postgres"         # postgres (default) | memory (dev/test only)
# CRON_SECRET=""                      # 16+ random chars; Vercel Cron sends it to /api/cron/rate-limit-cleanup
