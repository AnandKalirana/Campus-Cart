# Placeholders only. Copy to .env.local and fill in. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/campus_cart"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Public base URL, used in emailed links. Must be https in production.
APP_URL="http://localhost:3000"

# Neon (get values from the Neon console or `neon deploy`; keep real values in .env.local)
# DIRECT_URL is the non-pooled connection used by Prisma migrate. Optional for the app.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Auth.js: when self-hosting (not Vercel), tell it which host to trust, otherwise sign-in fails with "UntrustedHost".
# Set AUTH_URL to your public https URL (preferred) or AUTH_TRUST_HOST=true behind a trusted proxy.
# AUTH_URL="https://your-domain.example"
# AUTH_TRUST_HOST="true"
